PROCESO REGISTRODENOTAS
    DEFINIR NOTA, SUMANOTAS, PROMEDIO, PORCAPROBADOS COMO REAL
    DEFINIR APROBADOS, REPROBADOS, TOTAL COMO ENTERO
    SUMANOTAS = 0
    APROBADOS = 0
    REPROBADOS = 0
    TOTAL = 0
    HACER
        ESCRIBIR "INGRESE LA NOTA DEL ESTUDIANTE (0.0 A 5.0): "
        LEER NOTA
        SI NOTA < 0 O NOTA > 5 ENTONCES
            ESCRIBIR "ERROR: NOTA FUERA DEL RANGO."
        SINO
            SUMANOTAS = SUMANOTAS + NOTA
            TOTAL = TOTAL + 1
            SI NOTA >= 3 ENTONCES
                APROBADOS = APROBADOS + 1
            SINO
                REPROBADOS = REPROBADOS + 1
            FINSI
        FINSI
        ESCRIBIR "¿DESEA INGRESAR OTRA NOTA? (1 = SI, 0 = NO): "
        LEER NOTA
    MIENTRAS QUE NOTA = 1
    PROMEDIO = SUMANOTAS / TOTAL
    PORCAPROBADOS = (APROBADOS * 100) / TOTAL
    ESCRIBIR "TOTAL DE ESTUDIANTES EVALUADOS: ", TOTAL
    ESCRIBIR "APROBADOS: ", APROBADOS
    ESCRIBIR "REPROBADOS: ", REPROBADOS
    ESCRIBIR "PORCENTAJE DE APROBADOS: ", PORCAPROBADOS, "%"
    ESCRIBIR "NOTA PROMEDIO DEL GRUPO: ", PROMEDIO
FINPROCESO

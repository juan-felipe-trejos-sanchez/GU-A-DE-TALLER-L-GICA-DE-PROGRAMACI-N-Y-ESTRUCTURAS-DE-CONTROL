PROCESO VALIDACIONDEACCESO
    DEFINIR CLAVE, CLAVEINGRESADA, INTENTOS COMO ENTERO
    CLAVE = 1234
    INTENTOS = 0
    HACER
        ESCRIBIR "INGRESE LA CLAVE DE 4 DIGITOS: "
        LEER CLAVEINGRESADA
        SI CLAVEINGRESADA = CLAVE ENTONCES
            ESCRIBIR "ACCESO CONCEDIDO. INICIALIZANDO RUTINA DEL BRAZO ROBOTICO"
            INTENTOS = 3
        SINO
            INTENTOS = INTENTOS + 1
            ESCRIBIR "CLAVE INCORRECTA."
            SI INTENTOS = 3 ENTONCES
                ESCRIBIR "ALERTA: NUMERO MAXIMO DE INTENTOS ALCANZADO. SISTEMA BLOQUEADO"
            FINSI
        FINSI
    MIENTRAS QUE CLAVEINGRESADA <> CLAVE Y INTENTOS < 3
FINPROCESO

PROCESO CONTROLDECALIDAD
    DEFINIR PESO COMO REAL
    DEFINIR ACEPTADAS, RECHAZADAS, TOTAL, CONTINUAR COMO ENTERO
    ACEPTADAS = 0
    RECHAZADAS = 0
    TOTAL = 0
    HACER
        ESCRIBIR "INGRESE EL PESO DE LA PIEZA EN GRAMOS: "
        LEER PESO
        TOTAL = TOTAL + 1
        SI PESO >= 45 Y PESO <= 55 ENTONCES
            ESCRIBIR "PIEZA ACEPTADA"
            ACEPTADAS = ACEPTADAS + 1
        SINO
            ESCRIBIR "PIEZA RECHAZADA"
            RECHAZADAS = RECHAZADAS + 1
        FINSI
        ESCRIBIR "¿DESEA PROCESAR OTRA PIEZA? (1 = SI, 0 = NO): "
        LEER CONTINUAR
    MIENTRAS QUE CONTINUAR = 1
    ESCRIBIR "RESUMEN DEL TURNO"
    ESCRIBIR "TOTAL DE PIEZAS PROCESADAS: ", TOTAL
    ESCRIBIR "TOTAL DE PIEZAS ACEPTADAS: ", ACEPTADAS
    ESCRIBIR "TOTAL DE PIEZAS RECHAZADAS: ", RECHAZADAS
FINPROCESO

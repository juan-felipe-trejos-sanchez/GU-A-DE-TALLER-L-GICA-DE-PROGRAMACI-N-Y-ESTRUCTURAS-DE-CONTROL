PROCESO LLENADODETANQUE
    DEFINIR NIVEL, LITROS COMO REAL
    ESCRIBIR "INGRESE EL NIVEL INICIAL DEL TANQUE EN LITROS: "
    LEER NIVEL
    HACER
        ESCRIBIR "INGRESE LOS LITROS QUE ENTRAN EN ESTE CICLO: "
        LEER LITROS
        NIVEL = NIVEL + LITROS
        ESCRIBIR "NIVEL ACTUAL: ", NIVEL, " LITROS"
    MIENTRAS QUE NIVEL < 100
    ESCRIBIR "¡TANQUE LLENO! DESCONECTANDO BOMBA"
    ESCRIBIR "NIVEL FINAL ALCANZADO: ", NIVEL, " LITROS"	
FINPROCESO

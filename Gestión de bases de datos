PROCESO CONTROLDESTOCK
    DEFINIR STOCK, RETIRO COMO ENTERO
    ESCRIBIR "INGRESE EL STOCK INICIAL: "
    LEER STOCK
    HACER
        ESCRIBIR "INGRESE LA CANTIDAD A RETIRAR (0 PARA TERMINAR): "
        LEER RETIRO
        SI RETIRO > STOCK ENTONCES
            ESCRIBIR "STOCK INSUFICIENTE. DISPONIBLE: ", STOCK, " UNIDADES"
        SINO
            SI RETIRO > 0 ENTONCES
                STOCK = STOCK - RETIRO
                ESCRIBIR "NUEVO STOCK: ", STOCK
            FINSI
        FINSI
    MIENTRAS QUE STOCK > 0 Y RETIRO <> 0
    ESCRIBIR "STOCK FINAL: ", STOCK
FINPROCESO

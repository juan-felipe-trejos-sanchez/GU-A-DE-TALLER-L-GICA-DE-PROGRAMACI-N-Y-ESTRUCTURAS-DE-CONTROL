
	PROCESO COMPRASPRODUCTO
		DEFINIR PRECIO, CANTIDAD, SUBTOTAL, DESCUENTO COMO REAL
		DEFINIR TOTAL, IVA, TOTALAPAGAR COMO REAL
		TOTAL = 0
		HACER
			ESCRIBIR "INGRESE EL PRECIO DEL PRODUCTO (0 PARA TERMINAR): "
			LEER PRECIO
			SI PRECIO <> 0 ENTONCES
				ESCRIBIR "INGRESE LA CANTIDAD COMPRADA: "
				LEER CANTIDAD
				SUBTOTAL = PRECIO * CANTIDAD
				SI SUBTOTAL > 100000 ENTONCES
					DESCUENTO = SUBTOTAL * 0.10
					SUBTOTAL = SUBTOTAL - DESCUENTO
					ESCRIBIR "SE APLICÓ UN DESCUENTO DE $", DESCUENTO
				FINSI
				TOTAL = TOTAL + SUBTOTAL
			FINSI
		MIENTRAS QUE PRECIO <> 0
		IVA = TOTAL * 0.19
		TOTALAPAGAR = TOTAL + IVA
		ESCRIBIR "TOTAL DE LA COMPRA: $", TOTAL
		ESCRIBIR "IVA (19%): $", IVA
		ESCRIBIR "VALOR FINAL A PAGAR: $", TOTALAPAGAR
FINPROCESO
	
	
	

	
